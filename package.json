{
  "name": "ground-station-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile ground-control station for monitoring drone telemetry and mission progress in the field.",
  "license": "MIT",
  "author": "Pratyush Vatsa",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "demo": "tsc -p tsconfig.build.json && node scripts/demo-flight.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:core": "tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "expo": "~51.0.28",
    "expo-keep-awake": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-maps": "1.14.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-tcp-socket": "^6.0.6",
    "react-native-udp": "^4.1.7",
    "react-native-usb-serialport-for-android": "^1.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/node": "^20.14.0",
    "@types/react": "~18.2.79",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.1.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.3",
    "typescript": "~5.3.3",
    "vitest": "^4.1.11"
  }
}
